{
  "name": "orro-gateway",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "cd ../web && npm run build && cd ../gateway && wrangler deploy",
    "migrate": "wrangler d1 migrations apply orro-gateway --remote",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261113.1",
    "typescript": "5.9.3",
    "wrangler": "4.162.0"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  }
}
