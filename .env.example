# Copy to .env and fill in. .env is git-ignored.
ANTHROPIC_API_KEY=
DAYTONA_API_KEY=

# Optional: Daytona endpoint
# DAYTONA_API_URL=https://app.daytona.io/api
# DAYTONA_TARGET=us

# Optional: LangSmith tracing
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=deep-research

# Models. Use a cheaper model for the many analyst runs.
ANALYST_MODEL=anthropic:claude-haiku-5-5
INVESTIGATOR_MODEL=anthropic:claude-sonnet-5-5

# Daytona snapshot built by `uv run python -m deep_research.snapshot` (see README)
DAYTONA_SNAPSHOT=deep-research-lab

# The team hub (see README, "The team hub"). With these two set, this server sends its batches to the hub, shows
# the whole team's batches and costs, and takes any runner key missing above from the hub. Ask the owner for them.
# HUB_URL=https://research-hub.andresl.dev
# HUB_TOKEN=
# How your batches are labelled on the hub (default: this computer's hostname).
# HUB_MACHINE=your-name
