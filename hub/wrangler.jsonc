{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The team's shared record of batches, runs and costs (README.md, "The hub").
  "name": "deep-research-hub",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  // The team's address for the hub. Kept here so a deploy never drops the custom domain set up for it.
  "routes": [{ "pattern": "research-hub.andresl.dev", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "deep-research-hub",
      "database_id": "0541e366-8063-4af7-816d-9f02f767216a",
      "migrations_dir": "migrations"
    }
  ]
  // Secrets (wrangler secret put NAME): TEAM_TOKEN, plus the runner keys the hub hands out
  // (ANTHROPIC_API_KEY, DAYTONA_API_KEY, and optionally DAYTONA_API_URL, DAYTONA_TARGET, DAYTONA_SNAPSHOT, LANGSMITH_API_KEY).
}
